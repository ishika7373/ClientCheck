# ClientCheck - frontend configuration
# Copy to .env and fill in. Never commit .env.
#
# Supabase project ref: kufvqlqkmqnacicnritb
# The URL is derived from the project ref.
VITE_SUPABASE_URL=https://kufvqlqkmqnacicnritb.supabase.co
#
# Publishable anon key ONLY. This key is safe for browser use and must be
# paired with row level security on every table.
# NEVER put a service_role key, database password, or any other secret in a
# VITE_ prefixed variable: Vite inlines those into the client bundle.
VITE_SUPABASE_ANON_KEY=
